# Скопируй в .env и подставь свои значения

# База данных (Neon)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Резервный код премиума (ручная выдача)
PREMIUM_CODE=CHILL-PREMIUM

# Админ чата
CHAT_ADMIN_KEY=chillout-admin

# ==== VK OAuth (вход через VK) ====
# Создай приложение на https://dev.vk.com → тип "Веб-сайт"
VK_APP_ID=
VK_APP_SECRET=
# Базовый адрес сайта (для redirect_uri), напр. https://chilloutfm.vercel.app
APP_BASE_URL=

# ==== VK Donut Callback (авто-премиум после оплаты) ====
VK_CONFIRMATION_CODE=
VK_SECRET=
